[Unit]
Description=Terraria browser control panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=terraria
Group=terraria
WorkingDirectory=/opt/terraria
Environment=TERRARIA_ROOT=/opt/terraria
Environment=PANEL_HOST=127.0.0.1
Environment=PANEL_PORT=8765
Environment=GAME_PORT=7777
Environment=REST_PORT=7878
EnvironmentFile=-/etc/terraria-panel.env
ExecStart=/usr/bin/python3 /opt/terraria/Panel/Browser/server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=mixed

[Install]
WantedBy=multi-user.target
